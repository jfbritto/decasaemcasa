APP_NAME="De Casa em Casa"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=decasaemcasa
DB_USERNAME=decasaemcasa
DB_PASSWORD=root

BROADCAST_DRIVER=log
CACHE_DRIVER=redis
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120

REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail (local: MailHog via docker-compose / produção: Resend)
MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@decasaemcasa.omarcosalmeida.com.br"
MAIL_FROM_NAME="De Casa em Casa"

# Em produção, troque MAIL_MAILER=resend e defina RESEND_API_KEY:
# MAIL_MAILER=resend
RESEND_API_KEY=

# Mercado Pago
MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=

# WhatsApp (Twilio)
WHATSAPP_ENABLED=false
TWILIO_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

# Pix
PIX_KEY=
PIX_HOLDER="Marcos Almeida"

# Suporte ao participante (link/nº de WhatsApp para contato; atualizações da inscrição são só por e-mail)
SUPPORT_WHATSAPP_NUMBER="+55 27 99820-1544"
SUPPORT_WHATSAPP_LINK="https://wa.me/5527998201544"

# Admin
ADMIN_EMAIL=admin@decasaemcasa.com.br
ADMIN_PASSWORD=admin123

# Inscrições
INSCRIPTION_PAYMENT_DEADLINE_MINUTES=60
# Faixas "horasAteEvento:janelaEmMinutos" (vale quando faltar MAIS que as horas indicadas; minutos até 65535)
INSCRIPTION_PAYMENT_DEADLINE_TIERS="72:1440,48:360"

# App do participante (docs/superpowers/specs/2026-11-08-app-mobile-design.md)
# Conta de revisão das lojas: para este e-mail nenhum código sai por e-mail e o código fixo vale.
# Sem as duas (ou com código de menos de 12 números), não existe conta de revisão.
# Use um e-mail fictício, sem inscrição real, e um código só de números, aleatório e longo.
APP_REVIEW_EMAIL=
APP_REVIEW_CODE=
# Só com a "enhanced push security" ligada na conta do Expo; vazio, o push vai sem token.
EXPO_ACCESS_TOKEN=
